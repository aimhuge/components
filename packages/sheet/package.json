{
  "name": "@aimhuge/sheet",
  "version": "0.1.0",
  "description": "Any list of rows as a Google-Sheets-like table on glass: column specs, sort, filter by value with type-ahead, a search you start by typing, saved per table. The app brings the rows, its columns and its palette.",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./sheet.css": "./sheet.css"
  },
  "files": [
    "dist",
    "sheet.css",
    "README.md"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  }
}
