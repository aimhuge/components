{
  "name": "@aimhuge/billing",
  "version": "0.3.0",
  "description": "Plans, subscriptions, Stripe, invoices and a metered-usage ledger for the AimHuge apps: the provider seam, the Stripe adapter and webhook, the mock, the Supabase mirror, and the SQL it needs.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./test-cards": {
      "types": "./dist/test-cards.d.ts",
      "default": "./dist/test-cards.js"
    },
    "./sql/*": "./sql/*"
  },
  "files": [
    "dist",
    "sql",
    "README.md"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:stripe-live": "STRIPE_LIVE=1 vitest run src/__tests__/stripe.live.test.ts"
  },
  "dependencies": {
    "stripe": "22.5.0"
  },
  "peerDependencies": {
    "@supabase/supabase-js": "^2.0.0"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "@types/node": "^26.6.4",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  }
}
