{
  "name": "@aimhuge/auth",
  "version": "0.1.0",
  "description": "Supabase sign-in for the AimHuge Next.js apps: the login form, the signed-in banner, the /auth/callback and /auth/confirm handlers, and the session helpers.",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./auth.css": "./auth.css"
  },
  "files": [
    "dist",
    "auth.css",
    "README.md"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@supabase/ssr": ">=0.9.0",
    "@supabase/supabase-js": "^2.0.0",
    "lucide-react": ">=1.0.0",
    "next": ">=16.0.0",
    "react": ">=19.0.0"
  },
  "devDependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.1",
    "lucide-react": "^1.51.0",
    "next": "16.3.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  }
}
