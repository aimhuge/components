{
  "name": "@aimhuge/admin",
  "version": "0.1.0",
  "description": "The shape of a super-admin page: search, sort, paginated table, the acting-as banner, and the page guard. App brings the column defs and the data fetching.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./columns": {
      "types": "./dist/columns/index.d.ts",
      "default": "./dist/columns/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@aimhuge/teams": ">=0.5.0",
    "@tanstack/react-table": "^8.0.0",
    "date-fns": ">=3.0.0",
    "lucide-react": ">=1.0.0",
    "next": ">=16.0.0",
    "react": ">=19.0.0"
  },
  "devDependencies": {
    "@aimhuge/admin": "workspace:*",
    "@aimhuge/teams": "workspace:*",
    "date-fns": "^4.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.1",
    "lucide-react": "^1.51.0",
    "next": "16.3.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  }
}
